# Gotardo Finanças — variáveis de ambiente (desenvolvimento)
# Copie para .env e ajuste conforme necessário: `cp .env.example .env`

# --- Banco de dados (PostgreSQL 16) ---
POSTGRES_USER=gotardo
POSTGRES_PASSWORD=gotardo
POSTGRES_DB=gotardo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gotardo:gotardo@localhost:5432/gotardo?schema=public

# --- Redis (fila/async) ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- MinIO (S3-compatível) ---
MINIO_ROOT_USER=gotardo
MINIO_ROOT_PASSWORD=gotardo-secret
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=gotardo

# --- API (autenticação JWT) ---
# Gere segredos fortes: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-por-segredo-forte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000