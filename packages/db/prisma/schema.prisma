generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (espelham packages/shared) ---

enum Currency {
  BRL
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
  CREDIT_CARD
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVIEW
}

enum TransactionSource {
  MANUAL
  IMPORT
  RECURRING
  OCR
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DocumentStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  CASH
  OTHER
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GoalStrategy {
  FIXED
  PERCENTAGE
  PROPORTIONAL
  OPPORTUNISTIC
}

enum AllocationSource {
  MANUAL
  AUTO
}

enum NotificationType {
  BUDGET_EXCEEDED
  ANOMALY_DETECTED
  GOAL_AT_RISK
  DUPLICATE_DETECTED
  DOCUMENT_PENDING
  ACCOUNT_DUE
  RECURRING_GENERATED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

// --- Tenant (isolamento por família) ---

model Family {
  id             String          @id @default(cuid())
  name           String
  currency       Currency        @default(BRL)
  users          User[]
  accounts       Account[]
  categories     Category[]
  envelopes      Envelope[]
  incomeSources  IncomeSource[]
  transactions   Transaction[]
  documents      Document[]
  recurringRules RecurringRule[]
  invitations    Invitation[]
  financialGoals FinancialGoal[]
  notifications  Notification[]
  debts          Debt[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  name                   String
  passwordHash           String
  role                   FamilyRole         @default(MEMBER)
  familyId               String
  family                 Family             @relation(fields: [familyId], references: [id])
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  mutedNotificationTypes NotificationType[] @default([])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([familyId])
}

model RefreshToken {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  tokenHash    String         @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?        @unique
  replacedBy   RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedFrom RefreshToken[] @relation("TokenRotation")
  createdAt    DateTime       @default(now())

  @@index([userId])
}

model Invitation {
  id         String     @id @default(cuid())
  familyId   String
  family     Family     @relation(fields: [familyId], references: [id])
  email      String
  role       FamilyRole @default(MEMBER)
  tokenHash  String     @unique
  createdBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([familyId])
  @@index([email])
}

// --- Contas e categorias ---

model Account {
  id             String          @id @default(cuid())
  familyId       String
  family         Family          @relation(fields: [familyId], references: [id])
  name           String
  type           AccountType     @default(CHECKING)
  institution    String?
  currency       Currency        @default(BRL)
  balance        Decimal         @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal?        @db.Decimal(12, 2)
  billingDay     Int?
  dueDay         Int?
  isArchived     Boolean         @default(false)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([familyId])
}

model Category {
  id                    String          @id @default(cuid())
  familyId              String
  family                Family          @relation(fields: [familyId], references: [id])
  name                  String
  icon                  String?
  isEssential           Boolean         @default(false)
  isFixed               Boolean         @default(false)
  parentId              String?
  parent                Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[]      @relation("CategoryHierarchy")
  transactions          Transaction[]
  suggestedTransactions Transaction[]   @relation("TransactionSuggestedCategory")
  recurringRules        RecurringRule[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([familyId])
  @@index([parentId])
}

// --- Fontes de renda ---

model IncomeSource {
  id             String        @id @default(cuid())
  familyId       String
  family         Family        @relation(fields: [familyId], references: [id])
  name           String
  description    String?
  expectedAmount Decimal?      @db.Decimal(12, 2)
  isActive       Boolean       @default(true)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([familyId])
}

// --- Orçamento por envelopes ---

model Envelope {
  id             String               @id @default(cuid())
  familyId       String
  family         Family               @relation(fields: [familyId], references: [id])
  name           String
  icon           String?
  color          String?
  targetAmount   Decimal?             @db.Decimal(12, 2)
  isActive       Boolean              @default(true)
  transactions   Transaction[]
  allocations    EnvelopeAllocation[]
  recurringRules RecurringRule[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([familyId])
}

model EnvelopeAllocation {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([envelopeId])
}

// --- Metas e objetivos financeiros ---

model FinancialGoal {
  id                  String                    @id @default(cuid())
  familyId            String
  family              Family                    @relation(fields: [familyId], references: [id])
  name                String
  description         String?
  icon                String?
  targetAmount        Decimal                   @db.Decimal(12, 2)
  deadline            DateTime?
  priority            Int                       @default(2)
  status              GoalStatus                @default(ACTIVE)
  monthlyContribution Decimal?                  @db.Decimal(12, 2)
  strategy            GoalStrategy?
  allocations         FinancialGoalAllocation[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?

  @@index([familyId])
}

model FinancialGoalAllocation {
  id        String           @id @default(cuid())
  goalId    String
  goal      FinancialGoal    @relation(fields: [goalId], references: [id])
  amount    Decimal          @db.Decimal(12, 2)
  date      DateTime
  note      String?
  source    AllocationSource @default(MANUAL)
  createdAt DateTime         @default(now())

  @@index([goalId])
}

// --- Dívidas ---

model Debt {
  id                String        @id @default(cuid())
  familyId          String
  family            Family        @relation(fields: [familyId], references: [id])
  name              String
  creditor          String?
  totalAmount       Decimal       @db.Decimal(12, 2)
  interestRate      Decimal?      @db.Decimal(5, 2)
  installmentAmount Decimal?      @db.Decimal(12, 2)
  dueDay            Int?
  status            DebtStatus    @default(ACTIVE)
  payments          DebtPayment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([familyId])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([debtId])
}

// --- Transações ---

model Transaction {
  id                  String            @id @default(cuid())
  familyId            String
  family              Family            @relation(fields: [familyId], references: [id])
  accountId           String
  account             Account           @relation(fields: [accountId], references: [id])
  categoryId          String?
  category            Category?         @relation(fields: [categoryId], references: [id])
  suggestedCategoryId String?
  suggestedCategory   Category?         @relation("TransactionSuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  envelopeId          String?
  envelope            Envelope?         @relation(fields: [envelopeId], references: [id])
  incomeSourceId      String?
  incomeSource        IncomeSource?     @relation(fields: [incomeSourceId], references: [id])
  documentId          String?
  document            Document?         @relation(fields: [documentId], references: [id])
  date                DateTime
  description         String
  amount              Decimal           @db.Decimal(12, 2)
  type                TransactionType   @default(EXPENSE)
  status              TransactionStatus @default(PENDING)
  source              TransactionSource @default(MANUAL)
  externalId          String?
  paymentMethod       PaymentMethod?
  installmentNumber   Int?
  installmentTotal    Int?
  installmentGroupId  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@index([familyId])
  @@index([accountId])
  @@index([categoryId])
  @@index([suggestedCategoryId])
  @@index([envelopeId])
  @@index([incomeSourceId])
  @@index([date])
  @@index([installmentGroupId])
}

// --- Documentos (importação/OCR) e regras recorrentes ---

model Document {
  id            String         @id @default(cuid())
  familyId      String
  family        Family         @relation(fields: [familyId], references: [id])
  storageKey    String
  originalName  String
  mimeType      String
  sizeBytes     Int
  status        DocumentStatus @default(PENDING)
  errorMessage  String?
  extractedText String?
  transactions  Transaction[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([familyId])
}

model RecurringRule {
  id          String              @id @default(cuid())
  familyId    String
  family      Family              @relation(fields: [familyId], references: [id])
  accountId   String
  account     Account             @relation(fields: [accountId], references: [id])
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id])
  envelopeId  String?
  envelope    Envelope?           @relation(fields: [envelopeId], references: [id])
  description String
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType     @default(EXPENSE)
  frequency   RecurrenceFrequency @default(MONTHLY)
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([familyId])
  @@index([accountId])
}

// --- Notificações e alertas ---

model Notification {
  id        String               @id @default(cuid())
  familyId  String
  family    Family               @relation(fields: [familyId], references: [id])
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  severity  NotificationSeverity @default(INFO)
  isRead    Boolean              @default(false)
  actionUrl String?
  metadata  Json?
  dedupeKey String
  createdAt DateTime             @default(now())
  readAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([familyId])
  @@index([userId])
  @@index([dedupeKey])
}
