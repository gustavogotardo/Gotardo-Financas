{
  "name": "gotardo-financas",
  "version": "0.1.0",
  "private": true,
  "description": "Gotardo Finanças — gerenciamento e planejamento financeiro familiar (SaaS multi-tenant)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
