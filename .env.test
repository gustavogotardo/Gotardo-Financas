# Gotardo Finanças — variáveis de ambiente para TESTES
# Este arquivo é commitado para garantir consistência entre máquinas e CI.
# Usado por: make test-db-setup, testes de integração, testes e2e.
# NÃO use em produção — senhas fracas e fixas propositalmente.

# --- Banco de dados (PostgreSQL 16) ---
POSTGRES_USER=gotardo_test
POSTGRES_PASSWORD=gotardo_test
POSTGRES_DB=gotardo_test
POSTGRES_PORT=5433
DATABASE_URL=postgresql://gotardo_test:gotardo_test@localhost:5433/gotardo_test?schema=public

# --- Redis (fila/async) ---
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# --- MinIO (S3-compatível) ---
MINIO_ROOT_USER=gotardo_test
MINIO_ROOT_PASSWORD=gotardo_test_secret
MINIO_ENDPOINT=localhost:9100
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET=gotardo-test

# --- API (autenticação JWT) ---
# Secrets fixos para testes — NUNCA usar em produção
JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-production-abc123
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3001

# --- ML Service ---
ML_URL=http://localhost:8001
